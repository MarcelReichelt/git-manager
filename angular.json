{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "desktop": {
      "projectType": "application",
      "root": "src/desktop",
      "sourceRoot": "src/desktop",
      "prefix": "git-manager",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "out/desktop",
            "index": "src/desktop/index.html",
            "browser": "src/desktop/bootstrap.ts",
            "tsConfig": "src/desktop/tsconfig.app.json",
            "styles": ["src/desktop/styles.css"],
            "polyfills": [],
            "baseHref": "./",
            "outputHashing": "none"
          }
        }
      }
    }
  }
}
