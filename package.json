{
  "name": "@git-manager/main",
  "version": "0.2.5",
  "description": "Register local git repositories and create, merge, and remove worktrees",
  "type": "module",
  "bin": {
    "git-manager": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js"
  ],
  "scripts": {
    "build": "tsup",
    "pack:check": "node scripts/check-pack.mjs",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "link:global": "node scripts/link-global.mjs",
    "unlink:global": "node scripts/unlink-global.mjs",
    "bump": "yarn version patch --immediate",
    "bump:minor": "yarn version minor --immediate",
    "bump:major": "yarn version major --immediate",
    "publish": "yarn build && yarn pack:check && yarn link:global && yarn test && yarn npm publish",
    "publish:patch": "yarn bump && yarn publish",
    "publish:minor": "yarn bump:minor && yarn publish",
    "publish:major": "yarn bump:major && yarn publish"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.17.0",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "better-sqlite3": "^12.11.1",
    "commander": "^13.1.0",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
